{
  "name": "uyirkappan-backend",
  "version": "1.1.0",
  "description": "UyirKappan central backend — memory or MongoDB via data-store abstraction",
  "main": "server.js",
  "scripts": {
    "predev": "node scripts/ensure-port.js",
    "dev": "node server.js",
    "build": "tsc",
    "prestart": "node scripts/ensure-port.js",
    "start": "node server.js",
    "seed": "node src/seed/seed.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:phase18": "node --test test/phase18_four_level_testing.test.js",
    "test:all": "node scripts/run_all_tests.js",
    "matcher": "ts-node src/matcher/index.ts",
    "simulate": "node src/simulation/simulate.js",
    "simulate-ambulance": "node src/simulation/ambulance.simulator.js",
    "simulate-emergencies": "node src/simulation/emergency.simulator.js",
    "experiment": "node scripts/run_experiment.js",
    "kill-port": "node scripts/kill-port.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.6.0",
    "mongoose": "^8.5.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
