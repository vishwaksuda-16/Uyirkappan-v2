# Server
PORT=4000
BASE_URL=http://localhost:4000

# Authentication
JWT_SECRET=uyirkappan-dev-secret-change-me
JWT_EXPIRES_IN=7d

# Data store: "memory" (default) or "mongodb"
DATA_STORE_MODE=memory

# MongoDB Atlas — REQUIRED when DATA_STORE_MODE=mongodb
# Never commit a real URI; fill this in local .env only
MONGODB_URI=KEEP YOUR MONGODB_URI

# Driver response window before assignment TIMEOUT (ms)
DRIVER_RESPONSE_TIMEOUT_MS=15000
