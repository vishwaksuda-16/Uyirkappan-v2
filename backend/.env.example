# ==============================================================================
# UyirKappan Backend Environment Configuration Example
# ==============================================================================
# Copy this file to `backend/.env` for local execution.
# In production, ensure all REQUIRED variables are provided securely.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION (Optional in dev, defaults applied)
# ------------------------------------------------------------------------------
PORT=5000
HOST=0.0.0.0
BASE_URL=http://localhost:5000

# CORS Allowed Origins (Comma-separated or '*' for development)
CORS_ORIGINS=*

# Process Conflict Handling ('true' to auto-kill process occupying PORT)
AUTO_KILL_ON_CONFLICT=false

# ------------------------------------------------------------------------------
# 2. RUNTIME ENVIRONMENT & SECURITY
# ------------------------------------------------------------------------------
# Environment: 'development', 'test', 'production'
NODE_ENV=development

# JWT Secret (REQUIRED in production, strong random string)
# If NODE_ENV=production, server will FAIL FAST if the default secret is used.
JWT_SECRET=uyirkappan-dev-secret-change-me
JWT_EXPIRES_IN=7d

# Driver response window before assignment TIMEOUT (ms)
DRIVER_RESPONSE_TIMEOUT_MS=60000

# ------------------------------------------------------------------------------
# 3. DATABASE / PERSISTENCE LAYER
# ------------------------------------------------------------------------------
# Mode: "memory" (default for rapid local dev/test) or "mongodb" (production/durable)
DATA_STORE_MODE=memory

# MongoDB Connection URI
# CONDITIONAL: REQUIRED when DATA_STORE_MODE=mongodb.
# Server will FAIL FAST on startup if mode is mongodb and URI is absent.
# Format: mongodb://[user:password@]host[:port]/database[?options]
MONGODB_URI=

# MongoDB connection/operation timeout in milliseconds
MONGODB_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 4. TRAFFIC PROVIDER SUBSYSTEM
# ------------------------------------------------------------------------------
# Provider: "simulation" (default), "google", "mappls"
TRAFFIC_PROVIDER=simulation

# Fallback provider if external provider is selected but fails: "none", "simulation"
TRAFFIC_PROVIDER_FALLBACK=none

# External Provider Credentials (CONDITIONAL: required only if provider is google/mappls)
GOOGLE_MAPS_API_KEY=
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 5. DATASET & SPATIAL INFRASTRUCTURE OVERRIDES (Optional)
# ------------------------------------------------------------------------------
# Override default dataset directory (Defaults to Datasets/Datasets)
# DATASET_DIR=

# Override Chennai Road Centerline KML path (Defaults to Datasets/Spatial/chennai_road_centerline.kml)
# CHENNAI_ROAD_KML_PATH=

# Override Reference Baseline Dataset (Defaults to root dummy_ambulance_data.xlsx)
# BASELINE_DATASET_PATH=

# ------------------------------------------------------------------------------
# 6. LOGGING & DIAGNOSTICS
# ------------------------------------------------------------------------------
# Log level: 'debug', 'info', 'warn', 'error'
LOG_LEVEL=info
# Set to 'true' to silence console outputs during bulk testing
LOG_SILENT=false
