# UyirKappan Driver App - Environment Configuration Example
# Pass these via --dart-define or use a configuration runner

# Central Backend REST API Base URL (e.g. http://localhost:4000/api or https://api.uyirkappan.org/api)
API_BASE_URL=http://localhost:4000/api

# Central WebSocket / Socket.IO URL (e.g. http://localhost:4000 or https://socket.uyirkappan.org)
SOCKET_URL=http://localhost:4000

# Application Mode: 'simulation' or 'real'
APP_MODE=simulation
