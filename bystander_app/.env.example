# UyirKappan Bystander App - Environment Configuration Example
# Pass these via --dart-define or use a configuration runner

# Central Backend REST API Base URL (e.g. http://localhost:5000 or https://api.uyirkappan.org)
API_BASE_URL=http://localhost:5000

# Central WebSocket / Socket.IO URL (e.g. http://localhost:5000 or https://socket.uyirkappan.org)
SOCKET_URL=http://localhost:5000

# Set to true for live backend mode (default)
USE_REMOTE_BACKEND=true
